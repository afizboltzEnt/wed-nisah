# E-Wedding Dani & Anisah
# Salin ke .env.local dan isi nilai sebenar. Jangan commit .env.local.

# Supabase project: https://zbtozerufklismpxjvgj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://zbtozerufklismpxjvgj.supabase.co
# Anon key — Settings > API Keys di dashboard Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role (RAHSIA — hanya digunakan di server untuk /api/admin/rsvps)
# Settings > API Keys > service_role. JANGAN dedah kepada client.
SUPABASE_SERVICE_ROLE_KEY=

# Kata laluan halaman /admin
ADMIN_PASSWORD=